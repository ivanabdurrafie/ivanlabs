---
import { Sun, Moon, Search, Menu, X } from '@lucide/astro';
import { nav, withBase } from '../data/site';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = (Astro.url.pathname.replace(/\/$/, '') || basePath);

/** Active = this nav item's path is where we are (prefix, so /work/* counts as Work).
    Anchors (`/#…`) never highlight. */
const isActive = (href: string): boolean => {
  if (href.includes('#')) return false;
  const clean = withBase(href).replace(/\/$/, '');
  if (clean === basePath) return here === basePath;
  return here === clean || here.startsWith(clean + '/');
};
---

<nav class="navbar" aria-label="Primary">
  <a href={withBase('/')} class="nav-logo" aria-label="Ivan Abdurrafie — home">IA</a>

  <div class="nav-links" id="navLinks">
    {
      nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="idx" aria-hidden="true">{item.index}</span>
          {item.label}
        </a>
      ))
    }
  </div>

  <div class="nav-actions">
    <button class="nav-icon-btn" id="paletteBtn" aria-label="Open command menu">
      <Search size={14} aria-hidden="true" />
      <span class="palette-hint" aria-hidden="true">⌘K</span>
    </button>

    <button class="nav-icon-btn" id="themeToggle" aria-label="Toggle dark mode">
      <span class="icon-sun"><Sun size={15} aria-hidden="true" /></span>
      <span class="icon-moon"><Moon size={15} aria-hidden="true" /></span>
    </button>

    <button
      class="hamburger"
      id="hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <span class="icon-menu"><Menu size={18} aria-hidden="true" /></span>
      <span class="icon-close"><X size={18} aria-hidden="true" /></span>
    </button>
  </div>
</nav>
