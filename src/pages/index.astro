---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StackStrip from '../components/StackStrip.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Projects from '../components/Projects.astro';
import Marquee from '../components/Marquee.astro';
import Connect from '../components/Connect.astro';
---

<Base>
  <Hero />
  <StackStrip />

  {/* Proof second: the three case studies, one click deep */}
  <section id="work" class="section">
    <span class="legacy-anchor" id="systems" aria-hidden="true"></span>
    <div class="container">
      <SectionHeader index="01" title="Selected Work" />
      <Projects />
    </div>
  </section>

  <Marquee />
  <Connect />
</Base>
